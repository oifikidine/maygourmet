<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fournisseurs - May Gourmet</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍽️</text></svg>">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

  <!-- Barre de navigation -->
  <%- include('navbar'); %>

  <!-- Bandeau titre de la page -->
  <div class="page-banner">
    <h1>Nos fournisseurs 📦</h1>
    <p>Les partenaires qui approvisionnent May Gourmet en produits frais</p>
  </div>

  <!-- Contenu principal -->
  <main>

    <section>
      <h2>Liste des fournisseurs</h2>

      <!-- Barre de recherche + bouton Ajouter (côte à côte, même structure que équipe) -->
      <div class="search-bar">
        <input type="text" id="search-fournisseurs" placeholder="🔍 Rechercher un fournisseur...">

        <!-- Bouton qui ouvre la modal d'ajout -->
        <button id="btnAjoutFournisseur" class="btn-modal">➕ Ajouter un fournisseur</button>
      </div>

      <!-- ═══════════════════════════════════════════════════
           MODAL — Ajout d'un nouveau fournisseur
           Même structure que la modal d'ajout de l'équipe
           ═══════════════════════════════════════════════════ -->
      <div id="modalAjoutFournisseur" class="modal">
        <div class="modal-content">
          <span class="close" id="closeAjoutFournisseur">&times;</span>
          <h2>➕ Ajouter un fournisseur</h2>

          <!-- Formulaire — action POST vers la route back-end existante -->
          <form method="POST" action="/api/fournisseur">

            <p>
              <label for="inputNomF">Nom :</label><br>
              <input type="text" id="inputNomF" name="nomFournisseur"
                     placeholder="Nom du fournisseur" required>
            </p>
            <p>
              <label for="inputQuantite">Quantité :</label><br>
              <input type="number" id="inputQuantite" name="quantite"
                     placeholder="Quantité livrée" required>
            </p>
            <p>
              <label for="inputPrix">Prix du produit :</label><br>
              <input type="number" id="inputPrix" name="prix"
                     placeholder="Prix de la marchandise" required>
            </p>
            <p>
              <label for="inputTelF">Téléphone :</label><br>
              <input type="text" id="inputTelF" name="telephoneFournisseur"
                     placeholder="Téléphone du fournisseur" required>
            </p>
            <p>
              <label for="inputOrigine">Origine du produit :</label><br>
              <input type="text" id="inputOrigine" name="origine"
                     placeholder="Origine du produit" required>
            </p>
            <p>
              <label for="inputType">Type de produit :</label><br>
              <input type="text" id="inputType" name="type"
                     placeholder="Type de produit" required>
            </p>
            <p>
              <label for="inputMailF">Mail (facultatif) :</label><br>
              <input type="email" id="inputMailF" name="mailFournisseur"
                     placeholder="email@fournisseur.com">
            </p>

            <button type="submit" class="btn-confirmer">Ajouter</button>
            <button type="button" class="btn-annuler" id="btnFermerAjoutFournisseur">Annuler</button>
          </form>

        </div>
      </div>
      <!-- Fin modal ajout fournisseur -->

      <!-- Grille des cartes fournisseurs (même structure que équipe) -->
      <div class="cards-grid" id="cards-grid-fournisseurs">
        <% resultatFournisseur.forEach(result => { %>
          <div class="card">

            <!-- Face avant -->
            <div class="card-front">
              <!-- Avatar entreprise (même concept que les avatars équipe) -->
              <div class="avatar-cercle avatar-entreprise">📦</div>
              <div class="container">
                <h4><%= result.nom %></h4>
                <!-- Badge type de produit -->
                <span class="badge"><%= result.types %></span>
                <br>
                <button class="btn flip-btn flip-btn-front">ℹ️ Détails</button>
              </div>
            </div>

            <!-- Face arrière : toutes les infos du fournisseur -->
            <div class="card-back">
              <span class="card-back-icon">📦</span>
              <h4><%= result.nom %></h4>
              <span class="badge"><%= result.types %></span>

              <!-- Origine du produit -->
              <% if (result.origine) { %>
                <p>🌍 <%= result.origine %></p>
              <% } %>

              <!-- Quantité et prix -->
              <p>📊 Qté : <%= result.quantite %> — Prix : <%= result.prix %> €</p>

              <!-- Téléphone -->
              <% if (result.telephone) { %>
                <p>📞 <%= result.telephone %></p>
              <% } %>

              <!-- Mail facultatif -->
              <% if (result.mail) { %>
                <p>✉️ <%= result.mail %></p>
              <% } %>

              <button class="flip-btn">← Retour</button>
            </div>

          </div>
        <% }); %>
      </div>

    </section>

  </main>

  <!-- Pied de page enrichi -->
  <%- include('footer'); %>

  <!-- Scripts -->
  <script src="/javascript/script.js"></script>
  <script src="/javascript/effects.js"></script>

</body>
</html>
