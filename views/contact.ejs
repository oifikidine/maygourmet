<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Contact - May Gourmet</title>
</head>
<body>

  <!-- Inclure le fichier navbar.ejs pour avoir la barre de navigation -->
   <%- include('navbar'); %>

  <!-- Formulaire de contact -->
  <section>
    <form action="/envoyer-message" method="POST">
      
      <!-- Nom -->
      <label for="nom">Nom :</label>
      <input type="text" id="nom" name="nom" required>
      <br><br>

      <!-- Email -->
      <label for="email">Email :</label>
      <input type="email" id="email" name="email" required>
      <br><br>

      <!-- Message -->
      <label for="message">Message :</label>
      <br>
      <textarea id="message" name="message" rows="5" cols="30" required></textarea>
      <br><br>

      <!-- Bouton envoyer -->
      <button type="submit">Envoyer</button>

    </form>
  </section>

  <!-- Pied de page -->
  <footer>
    <p>&copy; 2026 - May Gourmet</p>
  </footer>

</body>
</html>